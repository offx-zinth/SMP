# SMP — Structural Memory Protocol configuration.
# Copy to .env for local development. NEVER commit .env (see .gitignore).

# Graph / vector store locations
SMP_GRAPH_PATH=.smp/graph.smpg
SMP_VECTOR_PATH=.smp/smp.smpv

# Server bind
SMP_HOST=0.0.0.0
SMP_PORT=8420

# Auth: empty SMP_API_KEYS_FILE + SMP_OPEN_MODE=1 => local dev (all scopes).
# Production: set SMP_API_KEYS_FILE to a JSON key file and SMP_OPEN_MODE=0.
SMP_API_KEYS_FILE=
SMP_OPEN_MODE=1
SMP_RATE_LIMIT_PER_MINUTE=0
SMP_MAX_REQUEST_BYTES=1048576

# Optional Redis for distributed rate limiting
SMP_REDIS_URL=

# Logging
RUST_LOG=info
